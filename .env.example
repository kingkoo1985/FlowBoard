# FlowBoard 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ============================================
# OpenClaw 配置（必需）
# ============================================

# OpenClaw 工作空间路径（在容器内挂载的路径）
OPENCLAW_WORKSPACE=/workspace

# OpenClaw Gateway 端口（用于项目切换唤醒事件）
OPENCLAW_GATEWAY_PORT=15988

# Webhook 令牌（用于项目切换唤醒事件）
# 生成命令：openssl rand -hex 16
OPENCLAW_HOOKS_TOKEN=

# ============================================
# 服务器配置（可选）
# ============================================

# FlowBoard 服务端口
FLOWBOARD_PORT=18790

# FlowBoard 绑定地址
FLOWBOARD_HOST=0.0.0.0

# ============================================
# Telegram Mini App 认证（可选）
# ============================================

# Telegram Bot Token（从 @BotFather 获取）
# 格式：1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=

# JWT 签名密钥（用于生成会话令牌）
# 生成命令：openssl rand -hex 32
JWT_SECRET=change-this-to-a-random-32-char-string-in-production

# 允许的 Telegram 用户 ID（逗号分隔）
# 格式：123456789,987654321
ALLOWED_USER_IDS=

# Dashboard 允许的来源（用于 CORS 和验证）
# 格式：https://dashboard.yourdomain.com
DASHBOARD_ORIGIN=

# 本地主机名（用于 LAN 访问，无需认证）
# 如果设置，来自此主名的访问不需要认证
# 格式：dashboard.yourdomain.com
LOCAL_HOSTNAME=

# 是否始终启用认证（true/false）
# 设置为 true 时，即使从本地也要求认证
AUTH_ALWAYS=false

# ============================================
# Docker 特定配置
# ============================================

# Node 环境（production/development）
NODE_ENV=production

# Cloudflare Tunnel 配置（可选）
TUNNEL_TOKEN=

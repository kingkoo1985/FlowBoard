# FlowBoard dashboard 认证的 Systemd drop-in
# 复制到 ~/.config/systemd/user/dashboard.service.d/auth.conf
# 然后执行：systemctl --user daemon-reload && systemctl --user restart dashboard
#
# Telegram Mini App 认证必需：
#   TELEGRAM_BOT_TOKEN  — 来自 @BotFather
#   JWT_SECRET          — 使用 openssl rand -hex 32 生成
#   ALLOWED_USER_IDS    — 逗号分隔的 Telegram 用户 ID
#   DASHBOARD_ORIGIN    — 你的公共 URL（用于 CORS）
#
# 可选：
#   AUTH_ALWAYS          — 设置为 "true" 用于非 Cloudflare 隧道（ngrok, Tailscale）

[Service]
Environment="TELEGRAM_BOT_TOKEN=<YOUR_BOT_TOKEN>"
Environment="JWT_SECRET=<YOUR_JWT_SECRET>"
Environment="ALLOWED_USER_IDS=<YOUR_TELEGRAM_USER_ID>"
Environment="DASHBOARD_ORIGIN=https://<YOUR_DOMAIN>"
# Environment="AUTH_ALWAYS=true"

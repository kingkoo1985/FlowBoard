# 复制到 dashboard/.env 并填写你的值

# Telegram Bot（认证必需）
BOT_TOKEN=your-telegram-bot-token
JWT_SECRET=your-random-secret-string
ALLOWED_USER_IDS=123456789

# 认证模式：设置为 "true" 要求每次请求都认证
# （在使用 Tailscale 或其他不带 CF-Ray 标头的隧道时有用）
AUTH_ALWAYS=false

# 可选：一个自定义主机名，绕过 Telegram 认证
# 适用于通过次要 Cloudflare Tunnel 主机名进行 LAN 访问
# 示例：LOCAL_HOSTNAME=dashboard.local.your-domain.com
LOCAL_HOSTNAME=

# --- Dashboard 服务器 ---

# Dashboard 端口（默认：18790）
# FLOWBOARD_PORT=18790

# Dashboard 绑定地址（默认：0.0.0.0）
# FLOWBOARD_HOST=0.0.0.0

# --- OpenClaw 集成 ---

# OpenClaw 工作空间路径（必需）
# OPENCLAW_WORKSPACE=/home/youruser/.openclaw/workspace
OPENCLAW_WORKSPACE=

# Gateway URL（默认：http://127.0.0.1:18789）
# OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789

# --- 画布 → 任务推广（智能体辅助）---
# 需要在 openclaw.json 中启用 OpenClaw webhooks：
#   { hooks: { enabled: true, token: "your-secret", path: "/hooks" } }

# 来自你的 openclaw.json hooks.token 的 webhook 令牌
OPENCLAW_HOOKS_TOKEN=

# 推广通知的投递渠道（默认：last）
# 选项：last, telegram, whatsapp, discord, slack, signal, feishu
OPENCLAW_DELIVER_CHANNEL=last

# 投递目标：用户 open_id（用于 feishu）、聊天 ID（Telegram）、电话号码（WhatsApp）、频道 ID（Discord）
# 示例：
#   Feishu:   OPENCLAW_DELIVER_TO=ou_b5b40e4f5b0e36a124fff581dc6c27d8
#   Telegram:  OPENCLAW_DELIVER_TO=123456789
#   WhatsApp:  OPENCLAW_DELIVER_TO=+15551234567
#   Discord:  OPENCLAW_DELIVER_TO=channel-id
# 留空以使用上次活跃聊天
OPENCLAW_DELIVER_TO=
